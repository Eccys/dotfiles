#!/bin/sh
cat <<'GRUB'
if [ "${grub_platform}" = "efi" ]; then
    menuentry 'AtlasOS (Windows)' --class windows --class atlasos --id windows {
        insmod part_gpt
        insmod fat
        insmod chain
        search --no-floppy --fs-uuid --set=root @WINDOWS_EFI_UUID@
        chainloader /EFI/Microsoft/Boot/bootmgfw.efi
    }
fi
GRUB
