GRUB_DEFAULT=windows
GRUB_TIMEOUT=10
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="Arch"
GRUB_CMDLINE_LINUX="rd.luks.name=@LUKS_UUID@=cryptroot root=/dev/mapper/cryptroot rootflags=subvol=@ rw"
GRUB_CMDLINE_LINUX_DEFAULT=""
GRUB_PRELOAD_MODULES="part_gpt fat"
GRUB_DISABLE_OS_PROBER=true
GRUB_DISABLE_LINUX_UUID=true
# GRUB_DISABLE_SUBMENU=y
GRUB_DISABLE_RECOVERY=true
GRUB_ENABLE_CRYPTODISK=n
GRUB_TERMINAL_OUTPUT="gfxterm"
GRUB_GFXMODE="2560x1440,1920x1080,auto"
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_FONT="/boot/grub/fonts/JetBrainsMono.pf2"
