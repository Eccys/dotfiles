#!/usr/bin/env python3
import os, subprocess, sys, tempfile
from pathlib import Path
os.umask(0o077)
if os.geteuid()!=0:sys.exit("Run with sudo")
punctuation={" ":"space", "-":"minus", "=":"equal", "[":"leftbrace", "]":"rightbrace", "\\":"backslash", ";":"semicolon", "'":"apostrophe", ",":"comma", ".":"dot", "/":"slash", "`":"grave"}
shifted=dict(zip("!@#$%^&*()",["1","2","3","4","5","6","7","8","9","0"]))
shifted.update({"_":"minus", "+":"equal", "{":"leftbrace", "}":"rightbrace", "|":"backslash", ":":"semicolon", '"':"apostrophe", "<":"comma", ">":"dot", "?":"slash", "~":"grave"})
def tokens(text):
    result=[]
    for c in text:
        if "a"<=c<="z" or c.isdigit() and c.isascii():result.append(c)
        elif "A"<=c<="Z":result.append("S-"+c.lower())
        elif c in punctuation:result.append(punctuation[c])
        elif c in shifted:result.append("S-"+shifted[c])
        else:raise ValueError("Credential contains unsupported characters")
    return " ".join(result)
if "--test-encoder" in sys.argv:
    print(tokens(sys.stdin.read()))
    sys.exit()
lines=["# Private credential macros. Managed by update-keyd-credential-macros.","[meta+alt]"]
for slot in "rpunefla":
    path=f"@HOME@/.local/share/credential-hotkeys/cred_{slot}.enc"
    result=subprocess.run(["runuser","-u","@USER@","--","systemd-creds","decrypt","--user",f"--name=cred_{slot}",path,"-"],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,check=True)
    text=result.stdout.decode()
    if not text:sys.exit("Empty credential; not changing keyd")
    lines.append(slot+" = macro("+tokens(text)+")")
include=Path("/etc/keyd/credential-macros")
main=Path("/etc/keyd/default.conf")
old_main=main.read_bytes()
old_include=include.read_bytes() if include.exists() else None
# Include files do not end in .conf, so keyd won't load a second device configuration.
if b"include credential-macros" not in old_main:
    config=old_main+b"\n[global]\nmacro_sequence_timeout = 1000\n\ninclude credential-macros\n"
else:config=old_main
try:
    include.write_text("\n".join(lines)+"\n");include.chmod(0o600)
    main.write_bytes(config)
    checked=subprocess.run(["keyd","check",str(main)],stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    if checked.returncode:raise RuntimeError("Keyd validation failed; details withheld to protect credentials")
    subprocess.run(["keyd","reload"],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=True)
except Exception:
    main.write_bytes(old_main)
    if old_include is None:include.unlink(missing_ok=True)
    else:include.write_bytes(old_include)
    raise
print("Installed and validated eight native keyd credential macros. Private file mode: 0600.")
