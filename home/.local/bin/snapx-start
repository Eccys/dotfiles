#!/usr/bin/env python3
"""Seed SnapX's session vault from a private key on the encrypted home filesystem."""
import ctypes as C
import os
from pathlib import Path
import stat

key_dir = Path.home() / '.local/share/snapx-private'
key_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
key_dir.chmod(0o700)
key_file = key_dir / 'master-key'
if not key_file.exists():
    alphabet = b'0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{}@%$#'
    raw = os.urandom(32)
    out = bytearray()
    for offset in range(0, 32, 4):
        value = int.from_bytes(raw[offset:offset+4], 'big')
        block = bytearray(5)
        for i in range(4, -1, -1):
            value, digit = divmod(value, 85)
            block[i] = alphabet[digit]
        out.extend(block)
    fd = os.open(key_file, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    with os.fdopen(fd, 'wb') as f:
        f.write(out)
if key_file.stat().st_uid != os.getuid() or stat.S_IMODE(key_file.stat().st_mode) != 0o600:
    raise SystemExit('SnapX private key must be owned by you with mode 0600')
lib = C.CDLL('libsecret-1.so.0')
lib.secret_schema_new.restype = C.c_void_p
lib.secret_schema_new.argtypes = [C.c_char_p, C.c_int]
schema = lib.secret_schema_new(b'org.freedesktop.Secret.Generic', 0,
                              C.c_char_p(b'service'), C.c_int(0),
                              C.c_char_p(b'account'), C.c_int(0), C.c_void_p())
lib.secret_password_store_sync.restype = C.c_int
lib.secret_password_store_sync.argtypes = [C.c_void_p,C.c_char_p,C.c_char_p,C.c_char_p,C.c_void_p,C.POINTER(C.c_void_p)]
error = C.c_void_p()
ok = lib.secret_password_store_sync(schema,b'session',b'SnapX/MasterEncryptionKey',
        key_file.read_bytes(),None,C.byref(error),
        C.c_char_p(b'service'),C.c_char_p(b'SnapX'),C.c_char_p(b'account'),
        C.c_char_p(b'MasterEncryptionKey'),C.c_void_p())
if not ok:
    raise SystemExit('Could not initialize SnapX session vault')
os.execvp('snapx-ui', ['snapx-ui', *os.sys.argv[1:]])
