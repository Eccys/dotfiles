#!/usr/bin/env python3
import subprocess, sys, time
from pathlib import Path
if len(sys.argv) != 2 or sys.argv[1] not in "rpunefla":
    sys.exit(2)
key = sys.argv[1]
credential=Path.home()/".local/share/credential-hotkeys"/f"cred_{key}.enc"
if not credential.exists():
    subprocess.run(["notify-send", "Credential hotkey not ready", "Windows credential decryption is still pending."], stderr=subprocess.DEVNULL)
    sys.exit(1)
result = subprocess.run(["systemd-creds", "decrypt", "--user", f"--name=cred_{key}", str(credential), "-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
if result.returncode or not result.stdout:
    subprocess.run(["notify-send", "Credential hotkey not ready", "Run credential-hotkeys-setup locally to populate this slot."], stderr=subprocess.DEVNULL)
    sys.exit(1)
secret = result.stdout
subprocess.run(["wtype", "-"], input=secret, check=True)
