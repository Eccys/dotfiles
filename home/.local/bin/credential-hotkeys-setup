#!/usr/bin/env python3
import getpass, json, subprocess, sys, os
from pathlib import Path
os.umask(0o077)
target=Path.home()/".local/share/credential-hotkeys"
target.mkdir(mode=0o700,exist_ok=True)
keys = "rpunefla"
if len(sys.argv) == 2:
    with open(sys.argv[1], encoding="utf-8-sig") as f:
        values = json.load(f)
    if not isinstance(values, dict) or any(k not in keys or not isinstance(v, str) for k, v in values.items()):
        sys.exit("Invalid credential export format")
elif len(sys.argv) == 1:
    values = {}
    print("Enter each credential privately. Input is hidden; leave blank to skip.")
    for key in keys:
        value = getpass.getpass(f"Win+Alt+{key}: ")
        if value:
            values[key] = value
else:
    sys.exit("Usage: credential-hotkeys-setup [export.json]")
for key, value in values.items():
    subprocess.run(["systemd-creds", "encrypt", "--user", "--with-key=host", f"--name=cred_{key}", "-", str(target/f"cred_{key}.enc")], input=value.encode(), stdout=subprocess.DEVNULL, check=True)
    print(f"Stored Win+Alt+{key} as an encrypted Linux credential.")
subprocess.run(["sudo", "/usr/local/sbin/update-keyd-credential-macros"], check=True)
print("Setup complete. Native keyd macros refreshed; no credential values were logged.")
