  "monitors": [
    {
      "name": "DP-3",
      "resW": 2560,
      "resH": 1440,
      "rate": 239.97,
      "x": 0,
      "y": 0,
      "scale": 1,
      "transform": 0
    },
    {
      "name": "HDMI-A-4",
      "resW": 1920,
      "resH": 1080,
      "rate": 60,
      "x": -1080,
      "y": 0,
      "scale": 1,
      "transform": 1
    }
  ]
