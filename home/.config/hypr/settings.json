      "mods": "$mainMod",
      "key": "mouse_left",
      "dispatcher": "workspace",
      "command": "e-1"
    },
    {
      "type": "bind",
      "mods": "$mainMod",
      "key": "mouse_right",
      "dispatcher": "workspace",
      "command": "e+1"
