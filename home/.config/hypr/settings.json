{
  "uiScale": 1,
  "openGuideAtStartup": false,
  "topbarHelpIcon": false,
  "wallpaperDir": "@HOME@/Pictures/Wallpapers",
  "language": "us",
  "kbOptions": "grp:win_space_toggle",
  "workspaceCount": 5,
